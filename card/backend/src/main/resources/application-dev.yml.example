# ===== 开发环境配置模板 =====
# 使用方法：复制此文件为 application-dev.yml 并填入真实值
# cp application-dev.yml.example application-dev.yml
# 注意：application-dev.yml 已加入 .gitignore，不会被提交

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/cardgame?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: YOUR_DB_PASSWORD_HERE

  jpa:
    database-platform: org.hibernate.dialect.MySQLDialect
    show-sql: true
    hibernate:
      ddl-auto: update
    defer-datasource-initialization: true

  sql:
    init:
      mode: always
      encoding: UTF-8
      data-locations: classpath:data.sql,classpath:character.sql

  # 邮件配置（163 SMTP SSL）
  mail:
    host: smtp.163.com
    port: 465
    username: YOUR_EMAIL@example.com
    password: YOUR_EMAIL_AUTH_CODE
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
          starttls:
            enable: false

# 应用自定义配置
app:
  jwt:
    secret: your-jwt-secret-at-least-32-characters-long
    expiration-hours: 24
    remember-me-expiration-hours: 336

  verification:
    code-expiry-minutes: 10
    resend-cooldown-seconds: 60

  mail:
    from: YOUR_EMAIL@example.com

  cors:
    allowed-origins: http://localhost:5173,http://127.0.0.1:5173

  upload:
    avatar-dir: uploads/avatars

logging:
  level:
    com.cardgame: DEBUG
    org.springframework.security: DEBUG
